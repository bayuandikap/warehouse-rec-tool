APP_NAME="Simpul Warehouse"
APP_ENV=production
APP_KEY=                        # REQUIRED — copy from your local: php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.infinityfreeapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────────
# Get these values from InfinityFree control panel → MySQL Databases
# The host is NOT "localhost" — copy the exact hostname shown in the panel
DB_CONNECTION=mysql
DB_HOST=sql123.infinityfree.com   # REPLACE with your actual host from control panel
DB_PORT=3306
DB_DATABASE=epiz_XXXXXXX_simpul   # REPLACE with your actual database name
DB_USERNAME=epiz_XXXXXXX_simpul   # REPLACE with your actual username
DB_PASSWORD=                      # REPLACE with your database password

# ── Cache / Session / Queue ────────────────────────────────────────────────────
# InfinityFree does not provide Redis. File drivers are required.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync             # No background workers on InfinityFree

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log                   # Not required for this app
