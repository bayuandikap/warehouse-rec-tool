APP_NAME="Simpul Warehouse"
APP_ENV=production
APP_KEY=                        # Run: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────────────
# Supported drivers: mysql, mariadb
# Use 'mariadb' for MariaDB 10.x; use 'mysql' for MySQL 8.0+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simpul_warehouse
DB_USERNAME=root
DB_PASSWORD=
# DB_COLLATION=utf8mb4_unicode_ci   # Uncomment for MariaDB < 11.x

# ── Cache / Session / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Mail (not required for this application) ──────────────────────────────────
MAIL_MAILER=log
